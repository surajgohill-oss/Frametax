DATABASE_URL=postgresql+asyncpg://concert:concert@db:5432/concert_tracker
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=["http://localhost:3000"]
MAX_TRACKED_EVENTS=30
DEFAULT_POLL_INTERVAL_MINUTES=60
SCREENSHOTS_DIR=/app/debug_screenshots
HTML_SNAPSHOTS_DIR=/app/debug_html

# SeatGeek API credentials — required for authenticated discovery
# Register at: https://seatgeek.com/account/develop
SEATGEEK_CLIENT_ID=
SEATGEEK_CLIENT_SECRET=

# Ticketmaster API key — required for primary + verified-resale ingestion
# Register at: https://developer.ticketmaster.com/products-and-docs/apis/getting-started/
TICKETMASTER_API_KEY=

# TickPick API key — optional; public listings work without one
TICKPICK_API_KEY=

# GameTime API key — required for authenticated listing access
GAMETIME_API_KEY=
