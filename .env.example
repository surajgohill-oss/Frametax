# Copy to .env and fill in values
# cp .env.example .env

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://concert:concert@localhost:5432/concert_tracker

# ── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ──────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production

# ── CORS (JSON array of allowed origins) ─────────────────
CORS_ORIGINS=["http://localhost:3000"]

# ── Polling ──────────────────────────────────────────────
MAX_TRACKED_EVENTS=30
DEFAULT_POLL_INTERVAL_MINUTES=60

# ── Debug / Playwright ───────────────────────────────────
SCREENSHOTS_DIR=./debug_screenshots
HTML_SNAPSHOTS_DIR=./debug_html

# ── Chrome Attach (optional — leave blank to use built-in browser) ─
# CDP_URL=http://localhost:9222
