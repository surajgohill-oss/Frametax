# CineGlobe Cross-Model Bridge — environment variable template.
# Copy to .env in this directory (backend/.env) and fill in real values.
# NEVER commit .env — it is already in .gitignore. This file (.env.example)
# contains placeholders only and IS safe to commit.

# ── Provider API keys ────────────────────────────────────────────────
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional Gemini-compatible alias — only used if GEMINI_API_KEY is empty.
GOOGLE_API_KEY=

# ── Per-provider enable/disable (independent of whether a key is set) ──
BRIDGE_ANTHROPIC_ENABLED=true
BRIDGE_OPENAI_ENABLED=true
BRIDGE_GEMINI_ENABLED=true

# ── Model aliases (leave at defaults unless you know you need to pin a
# different model) ──
# BRIDGE_MODEL_CLAUDE_PRIMARY_REVIEW=claude-opus-4-1
# BRIDGE_MODEL_CLAUDE_FAST_RESEARCH=claude-sonnet-4-5
# BRIDGE_MODEL_OPENAI_PRIMARY_REVIEW=gpt-5.1
# BRIDGE_MODEL_OPENAI_FAST_RESEARCH=gpt-5.1-mini
# BRIDGE_MODEL_GEMINI_PRIMARY_REVIEW=gemini-3-pro
# BRIDGE_MODEL_GEMINI_FAST_RESEARCH=gemini-2.5-flash

# ── Cost / rate controls ──
# BRIDGE_REQUEST_TIMEOUT_SECONDS=90
# BRIDGE_MAX_RETRIES=3
# BRIDGE_MAX_CONCURRENCY=3
# BRIDGE_MAX_OUTPUT_TOKENS=8192

# ── Outbound-data policy ──
# BRIDGE_REQUIRE_CONFIDENTIAL_AUTHORIZATION=true
